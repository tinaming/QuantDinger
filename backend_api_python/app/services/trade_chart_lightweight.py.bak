"""
Trade chart visualization service.

Generates a self-contained HTML page using TradingView lightweight-charts
to display K-line candlesticks with trade markers overlaid.
"""
from __future__ import annotations

import json
import re
from datetime import datetime, timezone
from typing import Any, Dict, List, Optional

from app.utils.logger import get_logger

logger = get_logger(__name__)


# ---------------------------------------------------------------------------
# Trade type classification
# ---------------------------------------------------------------------------

_OPEN_TYPES = frozenset({
    "open_long", "open_short",
    "add_long", "add_short",
})

_CLOSE_TYPES = frozenset({
    "close_long", "close_short",
    "close_long_stop", "close_short_stop",
    "close_long_trailing", "close_short_trailing",
    "close_long_profit", "close_short_profit",
    "reduce_long", "reduce_short",
    "liquidation",
})


def _is_entry(trade_type: str) -> bool:
    t = (trade_type or "").lower()
    if t in _OPEN_TYPES:
        return True
    return t.startswith("open_") or t.startswith("add_")


def _is_exit(trade_type: str) -> bool:
    t = (trade_type or "").lower()
    if t in _CLOSE_TYPES:
        return True
    return t.startswith("close_") or t == "liquidation"


def _trade_side(trade_type: str) -> str:
    """Return 'long' or 'short' from trade type string."""
    t = (trade_type or "").lower()
    if "short" in t:
        return "short"
    return "long"


# ---------------------------------------------------------------------------
# Time helpers
# ---------------------------------------------------------------------------

def _parse_trade_time(raw: Any) -> Optional[int]:
    """Convert a trade time value to a Unix timestamp (seconds)."""
    if raw is None:
        return None
    if isinstance(raw, (int, float)):
        ts = int(raw)
        # Milliseconds guard
        if ts > 10_000_000_000:
            ts //= 1000
        return ts
    s = str(raw).strip()
    if not s:
        return None
    # Try ISO-like formats
    for fmt in ("%Y-%m-%d %H:%M", "%Y-%m-%d %H:%M:%S", "%Y-%m-%dT%H:%M:%S", "%Y-%m-%dT%H:%M"):
        try:
            dt = datetime.strptime(s, fmt).replace(tzinfo=timezone.utc)
            return int(dt.timestamp())
        except ValueError:
            continue
    # Unix numeric string
    try:
        ts = int(float(s))
        if ts > 10_000_000_000:
            ts //= 1000
        return ts
    except Exception:
        pass
    return None


# ---------------------------------------------------------------------------
# Candle data normalization
# ---------------------------------------------------------------------------

def _normalize_kline_time(raw: Any) -> Optional[int]:
    """Convert a kline time value to a Unix timestamp (seconds)."""
    if raw is None:
        return None
    if isinstance(raw, (int, float)):
        ts = int(raw)
        if ts > 10_000_000_000:
            ts //= 1000
        return ts
    s = str(raw).strip()
    for fmt in ("%Y-%m-%d %H:%M", "%Y-%m-%d %H:%M:%S", "%Y-%m-%dT%H:%M:%S"):
        try:
            dt = datetime.strptime(s, fmt).replace(tzinfo=timezone.utc)
            return int(dt.timestamp())
        except ValueError:
            continue
    try:
        ts = int(float(s))
        if ts > 10_000_000_000:
            ts //= 1000
        return ts
    except Exception:
        return None


def _prepare_candles(klines: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    """Convert raw kline rows to lightweight-charts candle series."""
    candles = []
    for row in klines:
        ts = _normalize_kline_time(row.get("time") or row.get("timestamp") or row.get("dt"))
        if ts is None:
            continue
        try:
            candles.append({
                "time": ts,
                "open": float(row.get("open", 0)),
                "high": float(row.get("high", 0)),
                "low": float(row.get("low", 0)),
                "close": float(row.get("close", 0)),
            })
        except Exception:
            continue
    candles.sort(key=lambda c: c["time"])
    return candles


def _prepare_markers(trades: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    """Convert trade rows to lightweight-charts marker objects."""
    markers = []
    for trade in trades:
        ts = _parse_trade_time(trade.get("time") or trade.get("created_at") or trade.get("timestamp"))
        if ts is None:
            continue
        trade_type = str(trade.get("type") or "")
        price = float(trade.get("price") or 0)
        profit = float(trade.get("profit") or 0)
        amount = float(trade.get("amount") or trade.get("size") or 0)
        side = _trade_side(trade_type)
        entry = _is_entry(trade_type)
        exit_ = _is_exit(trade_type)

        # Color / shape
        if entry and side == "long":
            color = "#22c55e"
            shape = "arrowUp"
            label = "买入"
        elif entry and side == "short":
            color = "#ef4444"
            shape = "arrowDown"
            label = "做空"
        elif exit_ and profit >= 0:
            color = "#22c55e"
            shape = "arrowDown"
            label = "平多" if side == "long" else "平空"
        elif exit_:
            color = "#ef4444"
            shape = "arrowUp"
            label = "平多" if side == "long" else "平空"
        else:
            color = "#60a5fa"
            shape = "circle"
            label = trade_type or "操作"

        pnl_str = f"+{profit:.2f}" if profit >= 0 else f"{profit:.2f}"
        # Format price without scientific notation
        if price >= 1000:
            price_str = f"{price:,.0f}"
        elif price >= 1:
            price_str = f"{price:.2f}"
        else:
            price_str = f"{price:.4f}"
        text = f"{label} {price_str} | {pnl_str}"

        markers.append({
            "time": ts,
            "position": "belowBar" if entry else "aboveBar",
            "color": color,
            "shape": shape,
            "text": text,
            # Stash extra fields for tooltip JS
            "_type": trade_type,
            "_price": price,
            "_amount": amount,
            "_profit": profit,
        })
    markers.sort(key=lambda m: m["time"])
    return markers


def _prepare_trade_table(trades: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    """Build table rows for the trade list below the chart."""
    rows = []
    for i, trade in enumerate(trades, 1):
        ts = _parse_trade_time(trade.get("time") or trade.get("created_at") or trade.get("timestamp"))
        trade_type = str(trade.get("type") or "")
        price = float(trade.get("price") or 0)
        amount = float(trade.get("amount") or trade.get("size") or 0)
        profit = float(trade.get("profit") or 0)
        balance = float(trade.get("balance") or 0)
        side = _trade_side(trade_type)
        entry = _is_entry(trade_type)

        time_str = ""
        if ts is not None:
            try:
                time_str = datetime.fromtimestamp(ts, tz=timezone.utc).strftime("%Y-%m-%d %H:%M")
            except Exception:
                time_str = str(trade.get("time") or "")

        direction = ""
        if entry:
            direction = "开多" if side == "long" else "开空"
        elif _is_exit(trade_type):
            direction = "平多" if side == "long" else "平空"
        else:
            direction = trade_type

        rows.append({
            "index": i,
            "time": time_str,
            "direction": direction,
            "type": trade_type,
            "price": price,
            "amount": amount,
            "profit": profit,
            "balance": balance,
            "side": side,
            "_ts": ts,  # Timestamp for chart navigation
        })
    return rows


# ---------------------------------------------------------------------------
# Summary stats
# ---------------------------------------------------------------------------

def _build_summary(trades: List[Dict[str, Any]]) -> Dict[str, Any]:
    """Compute basic summary from the trade list."""
    exits = [t for t in trades if _is_exit(str(t.get("type") or ""))]
    profits = [float(t.get("profit") or 0) for t in exits]
    wins = [p for p in profits if p > 0]
    losses = [p for p in profits if p < 0]
    total_pnl = sum(profits)
    win_rate = len(wins) / len(profits) * 100 if profits else 0.0
    max_win = max(profits) if profits else 0.0
    max_loss = min(profits) if profits else 0.0
    return {
        "total_trades": len(exits),
        "wins": len(wins),
        "losses": len(losses),
        "win_rate": round(win_rate, 1),
        "total_pnl": round(total_pnl, 2),
        "max_win": round(max_win, 2),
        "max_loss": round(max_loss, 2),
    }


# ---------------------------------------------------------------------------
# HTML generation
# ---------------------------------------------------------------------------

_LWCHARTS_CDN = "https://unpkg.com/lightweight-charts@4.1.3/dist/lightweight-charts.standalone.production.js"


def _calculate_rsi(candles: List[Dict], period: int = 14) -> List[Dict]:
    """Calculate RSI from candle data."""
    if len(candles) < period + 1:
        return []
    rsi_data = []
    gains = []
    losses = []
    for i in range(1, len(candles)):
        change = candles[i]['close'] - candles[i-1]['close']
        gains.append(max(0, change))
        losses.append(max(0, -change))
        if i >= period:
            avg_gain = sum(gains[-period:]) / period
            avg_loss = sum(losses[-period:]) / period
            if avg_loss == 0:
                rsi = 100
            else:
                rs = avg_gain / avg_loss
                rsi = 100 - (100 / (1 + rs))
            rsi_data.append({'time': candles[i]['time'], 'value': rsi})
    return rsi_data


def _calculate_kdj(candles: List[Dict], period: int = 9, k_smooth: int = 3, d_smooth: int = 3) -> List[Dict]:
    """Calculate KDJ from candle data."""
    if len(candles) < period:
        return []
    kdj_data = []
    k = 50
    d = 50
    for i in range(period - 1, len(candles)):
        window = candles[i-period+1:i+1]
        low = min(c['low'] for c in window)
        high = max(c['high'] for c in window)
        if high == low:
            rsv = 50
        else:
            rsv = (candles[i]['close'] - low) / (high - low) * 100
        k = (2/3) * k + (1/3) * rsv
        d = (2/3) * d + (1/3) * k
        j = 3 * k - 2 * d
        kdj_data.append({'time': candles[i]['time'], 'k': k, 'd': d, 'j': j})
    return kdj_data


def _calculate_bollinger_bands(candles: List[Dict], period: int = 20, std_dev: float = 2.0) -> Dict[str, List[Dict]]:
    """Calculate Bollinger Bands (upper, middle, lower) from candle data."""
    if len(candles) < period:
        return {'upper': [], 'middle': [], 'lower': []}
    upper, middle, lower = [], [], []
    for i in range(period - 1, len(candles)):
        window = [candles[j]['close'] for j in range(i - period + 1, i + 1)]
        sma = sum(window) / period
        variance = sum((x - sma) ** 2 for x in window) / period
        std = variance ** 0.5
        upper.append({'time': candles[i]['time'], 'value': sma + std_dev * std})
        middle.append({'time': candles[i]['time'], 'value': sma})
        lower.append({'time': candles[i]['time'], 'value': sma - std_dev * std})
    return {'upper': upper, 'middle': middle, 'lower': lower}


def build_chart_html(
    klines: List[Dict[str, Any]],
    trades: List[Dict[str, Any]],
    *,
    symbol: str = "",
    timeframe: str = "",
    theme: str = "dark",
    result_id: Optional[int] = None,
    backend_url: str = "",
) -> str:
    """
    Build a self-contained HTML page with:
      - lightweight-charts candlestick chart
      - Trade markers overlaid
      - RSI and KDJ indicators
      - Timeframe selector
      - Toggle for trade markers
      - Summary stats card
      - Trade detail table
    """
    candles = _prepare_candles(klines)
    markers = _prepare_markers(trades)
    table_rows = _prepare_trade_table(trades)
    summary = _build_summary(trades)
    rsi_data = _calculate_rsi(candles)
    kdj_data = _calculate_kdj(candles)
    bb_data = _calculate_bollinger_bands(candles)

    # Strip internal fields before serializing for JS
    markers_for_js = []
    for m in markers:
        markers_for_js.append({
            "time": m["time"],
            "position": m["position"],
            "color": m["color"],
            "shape": m["shape"],
            "text": m["text"],
        })

    candles_json = json.dumps(candles, ensure_ascii=False)
    markers_json = json.dumps(markers_for_js, ensure_ascii=False)
    table_json = json.dumps(table_rows, ensure_ascii=False)
    summary_json = json.dumps(summary, ensure_ascii=False)
    rsi_json = json.dumps(rsi_data, ensure_ascii=False)
    kdj_json = json.dumps(kdj_data, ensure_ascii=False)
    bb_json = json.dumps(bb_data, ensure_ascii=False)

    title = f"{symbol or '策略'} · {timeframe or ''} · 交易复盘".strip(" ·")

    html = f"""<!DOCTYPE html>
<html lang="zh-cmn-Hans">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>{title} — ChanQuant</title>
<style>
  * {{ box-sizing: border-box; margin: 0; padding: 0; }}
  body {{
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, sans-serif;
    background: #0b1120;
    color: #f8fafc;
  }}
  .header {{
    padding: 16px 24px;
    border-bottom: 1px solid rgba(148,163,184,0.15);
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }}
  .header h1 {{
    font-size: 18px;
    font-weight: 700;
    color: #f8fafc;
  }}
  .header .subtitle {{
    font-size: 13px;
    color: #94a3b8;
  }}
  .stats-bar {{
    display: flex;
    gap: 12px;
    padding: 12px 24px;
    flex-wrap: wrap;
    border-bottom: 1px solid rgba(148,163,184,0.1);
  }}
  .stat-card {{
    background: rgba(30,41,59,0.7);
    border: 1px solid rgba(148,163,184,0.12);
    border-radius: 10px;
    padding: 10px 16px;
    min-width: 100px;
  }}
  .stat-label {{ font-size: 11px; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.5px; }}
  .stat-value {{ font-size: 18px; font-weight: 700; margin-top: 2px; }}
  .stat-value.positive {{ color: #22c55e; }}
  .stat-value.negative {{ color: #ef4444; }}
  .stat-value.neutral  {{ color: #60a5fa; }}
  .controls {{
    padding: 12px 24px;
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
    border-bottom: 1px solid rgba(148,163,184,0.1);
  }}
  .controls label {{ font-size: 12px; color: #94a3b8; }}
  .tf-btn {{
    background: rgba(30,41,59,0.7);
    border: 1px solid rgba(148,163,184,0.2);
    color: #cbd5e1;
    padding: 6px 12px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 12px;
  }}
  .tf-btn:hover {{ background: rgba(59,130,246,0.2); }}
  .tf-btn.active {{ background: #3b82f6; color: white; border-color: #3b82f6; }}
  .toggle-btn {{
    background: rgba(30,41,59,0.7);
    border: 1px solid rgba(148,163,184,0.2);
    color: #cbd5e1;
    padding: 6px 12px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 12px;
    margin-left: auto;
  }}
  .toggle-btn:hover {{ background: rgba(59,130,246,0.2); }}
  .toggle-btn.active {{ background: #22c55e; color: white; border-color: #22c55e; }}
  #chart-container {{
    width: 100%;
    height: 480px;
    padding: 8px 12px;
  }}
  .indicator-panel {{
    width: 100%;
    height: 200px;
    padding: 8px 12px;
    border-top: 1px solid rgba(148,163,184,0.1);
  }}
  .table-section {{
    padding: 16px 24px;
  }}
  .table-section h2 {{
    font-size: 15px;
    font-weight: 600;
    margin-bottom: 10px;
    color: #cbd5e1;
  }}
  table {{
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }}
  thead th {{
    text-align: left;
    padding: 8px 10px;
    border-bottom: 1px solid rgba(148,163,184,0.2);
    color: #94a3b8;
    font-weight: 600;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    cursor: pointer;
    user-select: none;
  }}
  thead th:hover {{ color: #f8fafc; }}
  tbody tr {{
    border-bottom: 1px solid rgba(148,163,184,0.08);
    transition: background 0.12s;
  }}
  tbody tr:hover {{ background: rgba(59,130,246,0.08); }}
  tbody td {{
    padding: 7px 10px;
    color: #e2e8f0;
  }}
  .dir-long {{ color: #22c55e; font-weight: 600; }}
  .dir-short {{ color: #ef4444; font-weight: 600; }}
  .pnl-pos {{ color: #22c55e; }}
  .pnl-neg {{ color: #ef4444; }}
  .sort-arrow {{ margin-left: 4px; font-size: 10px; }}
  .empty-state {{
    text-align: center;
    padding: 48px;
    color: #64748b;
    font-size: 14px;
  }}
</style>
</head>
<body>

<div class="header">
  <h1>{title}</h1>
  <span class="subtitle">Generated by ChanQuant · lightweight-charts</span>
</div>

<div class="stats-bar" id="stats-bar"></div>

<div class="controls">
  <label>时间周期:</label>
  <button class="tf-btn" data-tf="1m">1m</button>
  <button class="tf-btn" data-tf="5m">5m</button>
  <button class="tf-btn" data-tf="15m">15m</button>
  <button class="tf-btn" data-tf="30m">30m</button>
  <button class="tf-btn" data-tf="1H">1H</button>
  <button class="tf-btn" data-tf="4H">4H</button>
  <button class="tf-btn active" data-tf="{timeframe or '1D'}">{timeframe or '1D'}</button>
  <button class="tf-btn" data-tf="1W">1W</button>
  <button class="toggle-btn active" id="toggle-markers">显示交易标记</button>
</div>

<div id="chart-container"></div>
<div class="indicator-panel" id="rsi-container"></div>
<div class="indicator-panel" id="kdj-container"></div>

<div class="table-section">
  <h2>交易明细</h2>
  <table id="trade-table">
    <thead>
      <tr>
        <th data-col="index">#</th>
        <th data-col="time">时间</th>
        <th data-col="direction">方向</th>
        <th data-col="price">成交价</th>
        <th data-col="amount">数量</th>
        <th data-col="profit">盈亏</th>
        <th data-col="balance">账户余额</th>
      </tr>
    </thead>
    <tbody id="trade-tbody"></tbody>
  </table>
</div>

<script src="{_LWCHARTS_CDN}"></script>
<script>
(function() {{
  // ---- Data ----
  const candles = {candles_json};
  const markers = {markers_json};
  const tableData = {table_json};
  const summary = {summary_json};
  const rsiData = {rsi_json};
  const kdjData = {kdj_json};
  const bbData = {bb_json};
  let markersVisible = true;
  const backendUrl = "{backend_url}";

  // ---- Stats bar ----
  const statsEl = document.getElementById('stats-bar');
  const statItems = [
    {{ label: '总交易次数', value: summary.total_trades, cls: 'neutral' }},
    {{ label: '胜率', value: summary.win_rate + '%', cls: summary.win_rate >= 50 ? 'positive' : 'negative' }},
    {{ label: '总盈亏', value: (summary.total_pnl >= 0 ? '+' : '') + summary.total_pnl.toFixed(2), cls: summary.total_pnl >= 0 ? 'positive' : 'negative' }},
    {{ label: '最大盈利', value: '+' + summary.max_win.toFixed(2), cls: 'positive' }},
    {{ label: '最大亏损', value: summary.max_loss.toFixed(2), cls: 'negative' }},
    {{ label: '盈利次数', value: summary.wins, cls: 'positive' }},
    {{ label: '亏损次数', value: summary.losses, cls: 'negative' }},
  ];
  statsEl.innerHTML = statItems.map(s => `
    <div class="stat-card">
      <div class="stat-label">${{s.label}}</div>
      <div class="stat-value ${{s.cls}}">${{s.value}}</div>
    </div>
  `).join('');

  // ---- Chart ----
  let chart = null;
  let candleSeries = null;
  let rsiChart = null;
  let rsiSeries = null;
  let kdjChart = null;
  let kdjSeries = null;
  let bbUpperSeries = null;
  let bbMiddleSeries = null;
  let bbLowerSeries = null;
  let kSeries = null;
  let dSeries = null;
  let jSeries = null;

  if (!candles.length) {{
    document.getElementById('chart-container').innerHTML =
      '<div class="empty-state">暂无K线数据，无法渲染图表</div>';
  }} else {{
    const container = document.getElementById('chart-container');
    chart = LightweightCharts.createChart(container, {{
      width: container.clientWidth,
      height: 480,
      layout: {{
        background: {{ type: 'solid', color: '#0b1120' }},
        textColor: '#94a3b8',
        attributionLogo: false,
      }},
      grid: {{
        vertLines: {{ color: 'rgba(148,163,184,0.06)' }},
        horzLines: {{ color: 'rgba(148,163,184,0.06)' }},
      }},
      crosshair: {{
        mode: LightweightCharts.CrosshairMode.Normal,
      }},
      timeScale: {{
        timeVisible: true,
        secondsVisible: false,
        borderColor: 'rgba(148,163,184,0.15)',
      }},
      rightPriceScale: {{
        borderColor: 'rgba(148,163,184,0.15)',
      }},
    }});

    candleSeries = chart.addCandlestickSeries({{
      upColor: '#22c55e',
      downColor: '#ef4444',
      borderDownColor: '#ef4444',
      borderUpColor: '#22c55e',
      wickDownColor: '#ef4444',
      wickUpColor: '#22c55e',
    }});

    candleSeries.setData(candles);

    if (markers.length) {{
      candleSeries.setMarkers(markers);
    }}

    // ---- Bollinger Bands overlay on main chart ----
    if (bbData && bbData.upper && bbData.upper.length) {{
      bbUpperSeries = chart.addLineSeries({{
        color: '#f97316',
        lineWidth: 1,
        title: 'BB上轨',
        priceLineVisible: false,
        lastValueVisible: false,
      }});
      bbUpperSeries.setData(bbData.upper);

      bbMiddleSeries = chart.addLineSeries({{
        color: '#94a3b8',
        lineWidth: 1,
        lineStyle: 2,
        title: 'BB中轨',
        priceLineVisible: false,
        lastValueVisible: false,
      }});
      bbMiddleSeries.setData(bbData.middle);

      bbLowerSeries = chart.addLineSeries({{
        color: '#f97316',
        lineWidth: 1,
        title: 'BB下轨',
        priceLineVisible: false,
        lastValueVisible: false,
      }});
      bbLowerSeries.setData(bbData.lower);
    }}

    chart.timeScale().fitContent();

    window.addEventListener('resize', () => {{
      chart.applyOptions({{ width: container.clientWidth }});
    }});

    // ---- Time scale sync helper ----
    let syncingTimeScale = false;
    function syncTimeScale(source, targets) {{
      if (syncingTimeScale) return;
      syncingTimeScale = true;
      const range = source.getVisibleTimeRange();
      if (range) {{
        targets.forEach(t => {{
          if (t) t.setVisibleRange(range);
        }});
      }}
      syncingTimeScale = false;
    }}

    // ---- RSI Panel ----
    if (rsiData.length) {{
      const rsiContainer = document.getElementById('rsi-container');
      rsiChart = LightweightCharts.createChart(rsiContainer, {{
        width: rsiContainer.clientWidth,
        height: 200,
        layout: {{ background: {{ type: 'solid', color: '#0b1120' }}, textColor: '#94a3b8', attributionLogo: false }},
        grid: {{ vertLines: {{ color: 'rgba(148,163,184,0.06)' }}, horzLines: {{ color: 'rgba(148,163,184,0.06)' }} }},
        rightPriceScale: {{ borderColor: 'rgba(148,163,184,0.15)' }},
        timeScale: {{ borderColor: 'rgba(148,163,184,0.15)', timeVisible: true }},
      }});
      rsiSeries = rsiChart.addLineSeries({{ color: '#a855f7', lineWidth: 2 }});
      rsiSeries.setData(rsiData);
      rsiChart.timeScale().fitContent();
      window.addEventListener('resize', () => rsiChart.applyOptions({{ width: rsiContainer.clientWidth }}));
      // Sync: main -> RSI
      chart.timeScale().subscribeVisibleTimeRangeChange(() => syncTimeScale(chart.timeScale(), [rsiChart ? rsiChart.timeScale() : null]));
      // Sync: RSI -> main
      rsiChart.timeScale().subscribeVisibleTimeRangeChange(() => syncTimeScale(rsiChart.timeScale(), [chart.timeScale()]));
    }}

    // ---- KDJ Panel ----
    if (kdjData.length) {{
      const kdjContainer = document.getElementById('kdj-container');
      kdjChart = LightweightCharts.createChart(kdjContainer, {{
        width: kdjContainer.clientWidth,
        height: 200,
        layout: {{ background: {{ type: 'solid', color: '#0b1120' }}, textColor: '#94a3b8', attributionLogo: false }},
        grid: {{ vertLines: {{ color: 'rgba(148,163,184,0.06)' }}, horzLines: {{ color: 'rgba(148,163,184,0.06)' }} }},
        rightPriceScale: {{ borderColor: 'rgba(148,163,184,0.15)' }},
        timeScale: {{ borderColor: 'rgba(148,163,184,0.15)', timeVisible: true }},
      }});
      kSeries = kdjChart.addLineSeries({{ color: '#3b82f6', lineWidth: 2, title: 'K' }});
      dSeries = kdjChart.addLineSeries({{ color: '#f59e0b', lineWidth: 2, title: 'D' }});
      jSeries = kdjChart.addLineSeries({{ color: '#ec4899', lineWidth: 2, title: 'J' }});
      kSeries.setData(kdjData.map(d => ({{ time: d.time, value: d.k }})));
      dSeries.setData(kdjData.map(d => ({{ time: d.time, value: d.d }})));
      jSeries.setData(kdjData.map(d => ({{ time: d.time, value: d.j }})));
      kdjChart.timeScale().fitContent();
      window.addEventListener('resize', () => kdjChart.applyOptions({{ width: kdjContainer.clientWidth }}));
      // Sync: main -> KDJ
      chart.timeScale().subscribeVisibleTimeRangeChange(() => syncTimeScale(chart.timeScale(), [kdjChart ? kdjChart.timeScale() : null]));
      // Sync: KDJ -> main
      kdjChart.timeScale().subscribeVisibleTimeRangeChange(() => syncTimeScale(kdjChart.timeScale(), [chart.timeScale()]));
    }}
  }}

  // ---- Toggle Markers ----
  const toggleBtn = document.getElementById('toggle-markers');
  if (toggleBtn) {{
    toggleBtn.addEventListener('click', () => {{
      markersVisible = !markersVisible;
      toggleBtn.classList.toggle('active', markersVisible);
      toggleBtn.textContent = markersVisible ? '显示交易标记' : '隐藏交易标记';
      if (typeof candleSeries !== 'undefined') {{
        candleSeries.setMarkers(markersVisible ? markers : []);
      }}
    }});
  }}

  // ---- Timeframe Switching (AJAX) ----
  const currentSymbol = "{symbol}";
  const currentResultId = "{result_id if result_id else ''}";
  const currentTf = "{timeframe or '1D'}";
  document.querySelectorAll('.tf-btn').forEach(btn => {{
    btn.addEventListener('click', async () => {{
      const tf = btn.dataset.tf;
      if (!tf || tf === (currentTf || '')) return;

      // Update active button
      document.querySelectorAll('.tf-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      // Fetch new data from backend
      try {{
        const token = localStorage.getItem('token') || '';
        const params = new URLSearchParams({{
          symbol: currentSymbol,
          timeframe: tf,
          market: 'Crypto'
        }});
        if (currentResultId) params.append('resultId', currentResultId);

        const apiBase = backendUrl || (window.location.origin && window.location.origin.startsWith('http') ? window.location.origin : '');
        const resp = await fetch(apiBase + '/api/chart/backtest/data?' + params.toString(), {{
          headers: {{ 'Authorization': 'Bearer ' + token }}
        }});
        const json = await resp.json();

        if (json.code === 1 && json.data) {{
          const newCandles = json.data.candles || [];
          const newMarkers = json.data.markers || [];
          const newTableData = json.data.trades || [];
          const newSummary = json.data.summary || {{}};
          const newBB = json.data.bb || null;
          const newRSI = json.data.rsi || [];
          const newKDJ = json.data.kdj || [];

          // Update chart
          if (typeof candleSeries !== 'undefined' && newCandles.length) {{
            candleSeries.setData(newCandles);
            if (markersVisible) {{
              candleSeries.setMarkers(newMarkers);
            }}
            // Update Bollinger Bands
            if (newBB && bbUpperSeries && bbMiddleSeries && bbLowerSeries) {{
              bbUpperSeries.setData(newBB.upper || []);
              bbMiddleSeries.setData(newBB.middle || []);
              bbLowerSeries.setData(newBB.lower || []);
            }}
            chart.timeScale().fitContent();
          }}

          // Update RSI
          if (rsiSeries && newRSI.length) {{
            rsiSeries.setData(newRSI);
          }}
          // Update KDJ
          if (kSeries && dSeries && jSeries && newKDJ.length) {{
            kSeries.setData(newKDJ.map(d => ({{ time: d.time, value: d.k }})));
            dSeries.setData(newKDJ.map(d => ({{ time: d.time, value: d.d }})));
            jSeries.setData(newKDJ.map(d => ({{ time: d.time, value: d.j }})));
          }}

          // Update stats
          if (newSummary.total_trades !== undefined) {{
            const statsEl = document.getElementById('stats-bar');
            const statItems = [
              {{ label: '总交易次数', value: newSummary.total_trades, cls: 'neutral' }},
              {{ label: '胜率', value: (newSummary.win_rate || 0) + '%', cls: (newSummary.win_rate || 0) >= 50 ? 'positive' : 'negative' }},
              {{ label: '总盈亏', value: ((newSummary.total_pnl || 0) >= 0 ? '+' : '') + (newSummary.total_pnl || 0).toFixed(2), cls: (newSummary.total_pnl || 0) >= 0 ? 'positive' : 'negative' }},
              {{ label: '最大盈利', value: '+' + (newSummary.max_win || 0).toFixed(2), cls: 'positive' }},
              {{ label: '最大亏损', value: (newSummary.max_loss || 0).toFixed(2), cls: 'negative' }},
              {{ label: '盈利次数', value: newSummary.wins || 0, cls: 'positive' }},
              {{ label: '亏损次数', value: newSummary.losses || 0, cls: 'negative' }},
            ];
            statsEl.innerHTML = statItems.map(s => `
              <div class="stat-card">
                <div class="stat-label">${{s.label}}</div>
                <div class="stat-value ${{s.cls}}">${{s.value}}</div>
              </div>
            `).join('');
          }}

          // Update table
          renderTable(newTableData);

          // Update header subtitle
          const subtitleEl = document.querySelector('.header .subtitle');
          if (subtitleEl) {{
            subtitleEl.textContent = `${{tf}} · Generated by ChanQuant`;
          }}
        }} else {{
          alert('切换时间周期失败: ' + (json.msg || '未知错误'));
        }}
      }} catch (err) {{
        console.error('Timeframe switch failed:', err);
        alert('切换时间周期失败: ' + err.message);
      }}
    }});
  }});

  // ---- Table ----
  const tbody = document.getElementById('trade-tbody');
  let selectedRow = null;

  function renderTable(rows) {{
    tbody.innerHTML = rows.map(r => {{
      const dirCls = r.side === 'long' ? 'dir-long' : 'dir-short';
      const pnlCls = r.profit >= 0 ? 'pnl-pos' : 'pnl-neg';
      const pnlStr = (r.profit >= 0 ? '+' : '') + r.profit.toFixed(2);
      return `<tr data-time="${{r._ts || ''}}" data-index="${{r.index}}">
        <td>${{r.index}}</td>
        <td>${{r.time}}</td>
        <td class="${{dirCls}}">${{r.direction}}</td>
        <td>${{r.price.toLocaleString(undefined, {{maximumFractionDigits: 6}})}}</td>
        <td>${{r.amount.toLocaleString(undefined, {{maximumFractionDigits: 6}})}}</td>
        <td class="${{pnlCls}}">${{pnlStr}}</td>
        <td>${{r.balance.toLocaleString(undefined, {{maximumFractionDigits: 2}})}}</td>
      </tr>`;
    }}).join('');

    // Add click handlers to rows
    tbody.querySelectorAll('tr').forEach(tr => {{
      tr.style.cursor = 'pointer';
      tr.addEventListener('click', () => {{
        const tradeTime = tr.dataset.time;
        if (!tradeTime || !chart) return;

        // Highlight selected row
        if (selectedRow) selectedRow.style.background = '';
        tr.style.background = 'rgba(59,130,246,0.2)';
        selectedRow = tr;

        // Scroll chart to trade time
        const tfSeconds = {{
          '1m': 60, '5m': 300, '15m': 900, '30m': 1800,
          '1H': 3600, '4H': 14400, '1D': 86400, '1W': 604800
        }}[currentTf] || 86400;
        const rangeSeconds = tfSeconds * 50;
        chart.timeScale().setVisibleRange({{
          from: parseInt(tradeTime) - rangeSeconds,
          to: parseInt(tradeTime) + rangeSeconds
        }});
      }});
    }});
  }}
  renderTable(tableData);

  // ---- Sort ----
  let sortCol = null;
  let sortAsc = true;
  document.querySelectorAll('#trade-table thead th').forEach(th => {{
    th.addEventListener('click', () => {{
      const col = th.dataset.col;
      if (sortCol === col) {{ sortAsc = !sortAsc; }} else {{ sortCol = col; sortAsc = true; }}
      const sorted = [...tableData].sort((a, b) => {{
        const va = a[col], vb = b[col];
        if (typeof va === 'number' && typeof vb === 'number') return sortAsc ? va - vb : vb - va;
        return sortAsc ? String(va).localeCompare(String(vb)) : String(vb).localeCompare(String(va));
      }});
      renderTable(sorted);
      // Update arrow
      document.querySelectorAll('#trade-table thead th').forEach(h => {{
        const arrow = h.querySelector('.sort-arrow');
        if (arrow) arrow.remove();
      }});
      const span = document.createElement('span');
      span.className = 'sort-arrow';
      span.textContent = sortAsc ? '▲' : '▼';
      th.appendChild(span);
    }});
  }});
}})();
</script>
</body>
</html>"""
    return html


# ---------------------------------------------------------------------------
# Combined review page: metrics + chart + trade table
# ---------------------------------------------------------------------------

def build_review_page_html(
    klines: List[Dict[str, Any]],
    trades: List[Dict[str, Any]],
    metrics: Dict[str, Any],
    *,
    symbol: str = "",
    timeframe: str = "",
    strategy_name: str = "",
    lookback_days: int = 30,
) -> str:
    """Build a combined performance-review + trade-chart HTML page.

    Shows:
      - Performance KPI cards (from review report metrics)
      - K-line candlestick chart with trade markers
      - Trade detail table
    """
    candles = _prepare_candles(klines)
    markers = _prepare_markers(trades)
    table_rows = _prepare_trade_table(trades)
    trade_summary = _build_summary(trades)

    # Strip internal fields before JS serialization
    markers_for_js = []
    for m in markers:
        markers_for_js.append({
            "time": m["time"],
            "position": m["position"],
            "color": m["color"],
            "shape": m["shape"],
            "text": m["text"],
        })

    candles_json = json.dumps(candles, ensure_ascii=False)
    markers_json = json.dumps(markers_for_js, ensure_ascii=False)
    table_json = json.dumps(table_rows, ensure_ascii=False)

    # Extract review metrics for display
    m = metrics or {}
    title = f"{strategy_name or symbol or '策略'} · {timeframe or ''} · 绩效复盘".strip(" ·")

    # Build KPI cards from metrics
    kpi_items = [
        {"label": "回看天数", "value": f"{int(m.get('lookback_days', lookback_days))}d", "cls": "neutral"},
        {"label": "初始资金", "value": f"{_as_float(m.get('initial_capital')):,.0f}", "cls": "neutral"},
        {"label": "当前权益", "value": f"{_as_float(m.get('current_equity')):,.2f}", "cls": "neutral"},
        {"label": "总净盈亏", "value": f"{_as_float(m.get('total_net_pnl')):+,.2f}", "cls": "positive" if _as_float(m.get('total_net_pnl')) >= 0 else "negative"},
        {"label": "窗口收益率", "value": f"{_as_float(m.get('window_return_pct')):+.2f}%", "cls": "positive" if _as_float(m.get('window_return_pct')) >= 0 else "negative"},
        {"label": "最大回撤", "value": f"{_as_float(m.get('window_max_drawdown_pct')):.2f}%", "cls": "negative"},
        {"label": "胜率", "value": f"{_as_float(m.get('win_rate')):.1f}%", "cls": "positive" if _as_float(m.get('win_rate')) >= 50 else "negative"},
        {"label": "盈亏比", "value": f"{_as_float(m.get('profit_factor')):.2f}", "cls": "positive" if _as_float(m.get('profit_factor')) >= 1 else "negative"},
        {"label": "期望值", "value": f"{_as_float(m.get('expectancy')):+,.2f}", "cls": "positive" if _as_float(m.get('expectancy')) >= 0 else "negative"},
        {"label": "交易次数", "value": f"{int(m.get('closing_events') or 0)}", "cls": "neutral"},
        {"label": "盈利次数", "value": f"{int(m.get('winning_trades') or 0)}", "cls": "positive"},
        {"label": "亏损次数", "value": f"{int(m.get('losing_trades') or 0)}", "cls": "negative"},
        {"label": "平均盈利", "value": f"{_as_float(m.get('avg_win')):+,.2f}", "cls": "positive"},
        {"label": "平均亏损", "value": f"{_as_float(m.get('avg_loss')):+,.2f}", "cls": "negative"},
        {"label": "最大单笔盈利", "value": f"{_as_float(m.get('max_win')):+,.2f}", "cls": "positive"},
        {"label": "最大单笔亏损", "value": f"{_as_float(m.get('max_loss')):+,.2f}", "cls": "negative"},
        {"label": "总手续费", "value": f"{_as_float(m.get('total_commission')):,.2f}", "cls": "neutral"},
        {"label": "最大连亏", "value": f"{int(m.get('max_consecutive_losses') or 0)}", "cls": "negative" if int(m.get('max_consecutive_losses') or 0) > 2 else "neutral"},
    ]

    kpi_html = "\n".join(
        f'<div class="kpi"><div class="kpi-label">{k["label"]}</div>'
        f'<div class="kpi-value {k["cls"]}">{k["value"]}</div></div>'
        for k in kpi_items
    )

    # Exit reason breakdown
    exit_reasons = m.get("exit_reason_counts") or {}
    reason_html = ""
    if exit_reasons:
        reason_rows = "\n".join(
            f'<tr><td>{k}</td><td>{v}</td></tr>' for k, v in exit_reasons.items()
        )
        reason_html = f"""
        <div class="panel">
          <h3>平仓原因分布</h3>
          <table class="mini-table">
            <thead><tr><th>原因</th><th>次数</th></tr></thead>
            <tbody>{reason_rows}</tbody>
          </table>
        </div>"""

    html = f"""<!DOCTYPE html>
<html lang="zh-cmn-Hans">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>{title} — ChanQuant 绩效复盘</title>
<style>
  * {{ box-sizing: border-box; margin: 0; padding: 0; }}
  body {{
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, sans-serif;
    background: #0b1120;
    color: #f8fafc;
  }}
  .header {{
    padding: 20px 28px;
    border-bottom: 1px solid rgba(148,163,184,0.15);
    display: flex; align-items: center; gap: 16px; flex-wrap: wrap;
  }}
  .header h1 {{ font-size: 20px; font-weight: 700; }}
  .header .sub {{ font-size: 13px; color: #94a3b8; }}

  /* KPI grid */
  .kpi-grid {{
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 10px;
    padding: 16px 28px;
    border-bottom: 1px solid rgba(148,163,184,0.1);
  }}
  .kpi {{
    background: rgba(30,41,59,0.7);
    border: 1px solid rgba(148,163,184,0.12);
    border-radius: 10px;
    padding: 12px 14px;
  }}
  .kpi-label {{ font-size: 11px; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.4px; }}
  .kpi-value {{ font-size: 17px; font-weight: 700; margin-top: 4px; }}
  .kpi-value.positive {{ color: #22c55e; }}
  .kpi-value.negative {{ color: #ef4444; }}
  .kpi-value.neutral  {{ color: #60a5fa; }}

  /* Chart */
  #chart-container {{ width: 100%; height: 460px; padding: 12px 16px; }}

  /* Panel */
  .panel {{
    padding: 16px 28px;
  }}
  .panel h3 {{
    font-size: 15px; font-weight: 600; margin-bottom: 10px; color: #cbd5e1;
  }}

  /* Mini table */
  .mini-table {{ border-collapse: collapse; font-size: 13px; width: auto; }}
  .mini-table th {{ text-align: left; padding: 6px 14px 6px 0; color: #94a3b8; font-size: 11px; text-transform: uppercase; border-bottom: 1px solid rgba(148,163,184,0.2); }}
  .mini-table td {{ padding: 5px 14px 5px 0; color: #e2e8f0; }}

  /* Trade table */
  table {{ width: 100%; border-collapse: collapse; font-size: 13px; }}
  thead th {{
    text-align: left; padding: 8px 10px;
    border-bottom: 1px solid rgba(148,163,184,0.2);
    color: #94a3b8; font-weight: 600; font-size: 11px;
    text-transform: uppercase; letter-spacing: 0.4px;
    cursor: pointer; user-select: none;
  }}
  thead th:hover {{ color: #f8fafc; }}
  tbody tr {{ border-bottom: 1px solid rgba(148,163,184,0.08); transition: background 0.12s; }}
  tbody tr:hover {{ background: rgba(59,130,246,0.08); }}
  tbody td {{ padding: 7px 10px; color: #e2e8f0; }}
  .dir-long {{ color: #22c55e; font-weight: 600; }}
  .dir-short {{ color: #ef4444; font-weight: 600; }}
  .pnl-pos {{ color: #22c55e; }}
  .pnl-neg {{ color: #ef4444; }}
  .sort-arrow {{ margin-left: 4px; font-size: 10px; }}
  .empty-state {{ text-align: center; padding: 48px; color: #64748b; font-size: 14px; }}
  .flex-row {{ display: flex; gap: 24px; flex-wrap: wrap; }}
  .flex-row > .panel {{ flex: 1; min-width: 240px; }}
</style>
</head>
<body>

<div class="header">
  <h1>{title}</h1>
  <span class="sub">ChanQuant 绩效复盘 · lightweight-charts</span>
</div>

<div class="kpi-grid">
{kpi_html}
</div>

<div id="chart-container"></div>

<div class="flex-row">
{reason_html}
</div>

<div class="panel">
  <h3>交易明细</h3>
  <table id="trade-table">
    <thead>
      <tr>
        <th data-col="index">#</th>
        <th data-col="time">时间</th>
        <th data-col="direction">方向</th>
        <th data-col="price">成交价</th>
        <th data-col="amount">数量</th>
        <th data-col="profit">盈亏</th>
        <th data-col="balance">账户余额</th>
      </tr>
    </thead>
    <tbody id="trade-tbody"></tbody>
  </table>
</div>

<script src="{_LWCHARTS_CDN}"></script>
<script>
(function() {{
  const candles = {candles_json};
  const markers = {markers_json};
  const tableData = {table_json};

  // ---- Chart ----
  if (!candles.length) {{
    document.getElementById('chart-container').innerHTML =
      '<div class="empty-state">暂无K线数据，无法渲染图表</div>';
  }} else {{
    const container = document.getElementById('chart-container');
    const chart = LightweightCharts.createChart(container, {{
      width: container.clientWidth,
      height: 440,
      layout: {{
        background: {{ type: 'solid', color: '#0b1120' }},
        textColor: '#94a3b8',
        attributionLogo: false,
      }},
      grid: {{
        vertLines: {{ color: 'rgba(148,163,184,0.06)' }},
        horzLines: {{ color: 'rgba(148,163,184,0.06)' }},
      }},
      crosshair: {{ mode: LightweightCharts.CrosshairMode.Normal }},
      timeScale: {{ timeVisible: true, secondsVisible: false, borderColor: 'rgba(148,163,184,0.15)' }},
      rightPriceScale: {{ borderColor: 'rgba(148,163,184,0.15)' }},
    }});

    const candleSeries = chart.addCandlestickSeries({{
      upColor: '#22c55e', downColor: '#ef4444',
      borderDownColor: '#ef4444', borderUpColor: '#22c55e',
      wickDownColor: '#ef4444', wickUpColor: '#22c55e',
    }});
    candleSeries.setData(candles);
    if (markers.length) candleSeries.setMarkers(markers);
    chart.timeScale().fitContent();
    window.addEventListener('resize', () => chart.applyOptions({{ width: container.clientWidth }}));
  }}

  // ---- Table ----
  const tbody = document.getElementById('trade-tbody');
  function renderTable(rows) {{
    tbody.innerHTML = rows.map(r => {{
      const dirCls = r.side === 'long' ? 'dir-long' : 'dir-short';
      const pnlCls = r.profit >= 0 ? 'pnl-pos' : 'pnl-neg';
      const pnlStr = (r.profit >= 0 ? '+' : '') + r.profit.toFixed(2);
      return `<tr>
        <td>${{r.index}}</td><td>${{r.time}}</td>
        <td class="${{dirCls}}">${{r.direction}}</td>
        <td>${{r.price.toLocaleString(undefined, {{maximumFractionDigits: 6}})}}</td>
        <td>${{r.amount.toLocaleString(undefined, {{maximumFractionDigits: 6}})}}</td>
        <td class="${{pnlCls}}">${{pnlStr}}</td>
        <td>${{r.balance.toLocaleString(undefined, {{maximumFractionDigits: 2}})}}</td>
      </tr>`;
    }}).join('');
  }}
  renderTable(tableData);

  // Sort
  let sortCol = null, sortAsc = true;
  document.querySelectorAll('#trade-table thead th').forEach(th => {{
    th.addEventListener('click', () => {{
      const col = th.dataset.col;
      if (sortCol === col) sortAsc = !sortAsc; else {{ sortCol = col; sortAsc = true; }}
      const sorted = [...tableData].sort((a, b) => {{
        const va = a[col], vb = b[col];
        if (typeof va === 'number' && typeof vb === 'number') return sortAsc ? va - vb : vb - va;
        return sortAsc ? String(va).localeCompare(String(vb)) : String(vb).localeCompare(String(va));
      }});
      renderTable(sorted);
      document.querySelectorAll('#trade-table thead th').forEach(h => {{
        const a = h.querySelector('.sort-arrow'); if (a) a.remove();
      }});
      const span = document.createElement('span');
      span.className = 'sort-arrow'; span.textContent = sortAsc ? '▲' : '▼';
      th.appendChild(span);
    }});
  }});
}})();
</script>
</body>
</html>"""
    return html


def _as_float(v: Any, default: float = 0.0) -> float:
    """Local helper mirroring strategy_review._as_float."""
    try:
        if v is None or v == "":
            return default
        return float(v)
    except Exception:
        return default
