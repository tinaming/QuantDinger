    "/api/coinos/hyperliquid/{action}": {
      "get": {
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HumanSuccessEnvelope"
                }
              }
            }
          }
        },
        "summary": "Hyperliquid whale analytics",
        "tags": [
          "CoinOS-Hyperliquid"
        ],
        "description": "Hyperliquid on-chain perpetuals analytics: whale positions, liquidations, open interest, trader statistics, smart money tracking. Endpoints: `hyperliquid/tickers`, `hyperliquid/whales/open-positions`, `hyperliquid/liquidations/history`, `hyperliquid/smart-money/find`, etc.",
        "operationId": "getApiCoinosHyperliquidAction",
        "x-visibility": "public"
      },
      "post": {
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HumanSuccessEnvelope"
                }
              }
            }
          }
        },
        "summary": "Hyperliquid whale analytics",
        "tags": [
          "CoinOS-Hyperliquid"
        ],
        "description": "Hyperliquid on-chain perpetuals analytics: whale positions, liquidations, open interest, trader statistics, smart money tracking. Endpoints: `hyperliquid/tickers`, `hyperliquid/whales/open-positions`, `hyperliquid/liquidations/history`, `hyperliquid/smart-money/find`, etc.",
        "operationId": "postApiCoinosHyperliquidAction",
        "x-visibility": "public"
      },
      "parameters": [
        {
          "in": "path",
          "name": "action",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    "/api/coinos/trading/{action}": {
      "post": {
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HumanSuccessEnvelope"
                }
              }
            }
          }
        },
        "summary": "CEX trading operations",
        "tags": [
          "CoinOS-Trading"
        ],
        "description": "Execute trades on Binance, OKX, Bybit, Bitget, Gate, HTX, Pionex, Hyperliquid. Actions: `create_order`, `close_position`, `set_stop`, `cancel_order`, `positions`, `open_orders`, `balance`, `markets`, `set_leverage`, `set_trading_params`, `save_key`. Two-step confirmation required for orders.",
        "operationId": "postApiCoinosTradingAction",
        "x-visibility": "internal"
      },
      "parameters": [
        {
          "in": "path",
          "name": "action",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "/api/coinos/trading/auto/{action}": {
      "post": {
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HumanSuccessEnvelope"
                }
              }
            }
          }
        },
        "summary": "Auto trading strategies",
        "tags": [
          "CoinOS-Trading"
        ],
        "description": "Automated trading strategy execution. Actions vary by script.",
        "operationId": "postApiCoinosTradingAutoAction",
        "x-visibility": "internal"
      },
      "parameters": [
        {
          "in": "path",
          "name": "action",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
