{
  "openapi": "3.0.3",
  "info": {
    "title": "ChanQuant CoinOS Skills API",
    "version": "1.0.0",
    "description": "CoinOS Skills integration — crypto market data (AiCoin 200+ exchanges), CEX trading (Binance/OKX/Bybit/etc.), Hyperliquid whale analytics, Freqtrade strategy management, on-chain DEX (OKX Web3), and exchange account management.\n\nPowered by [coinos-skills](https://github.com/aicoincom/coinos-skills).",
    "contact": {
      "name": "ChanQuant",
      "url": "https://github.com/brokermr810/chanquant"
    },
    "license": {
      "name": "See repository LICENSE"
    }
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Backend direct"
    },
    {
      "url": "http://localhost:8888",
      "description": "Docker Compose"
    }
  ],
  "tags": [
    {
      "name": "CoinOS",
      "description": "CoinOS Skills integration — crypto market data, trading, analytics (Internal)"
    },
    {
      "name": "CoinOS-Market",
      "description": "AiCoin market data — 200+ exchanges, 183 endpoints (Public)"
    },
    {
      "name": "CoinOS-Hyperliquid",
      "description": "Hyperliquid whale analytics and on-chain perp data (Public)"
    },
    {
      "name": "CoinOS-Trading",
      "description": "CEX trading via CCXT — Binance, OKX, Bybit, etc. (Internal)"
    },
    {
      "name": "CoinOS-Freqtrade",
      "description": "Freqtrade strategy create/backtest/deploy/control (Internal)"
    },
    {
      "name": "CoinOS-Account",
      "description": "Exchange account management and API key info (Internal)"
    },
    {
      "name": "CoinOS-Onchain",
      "description": "On-chain DEX via OKX Web3 — swap, wallet, gas (Internal)"
    }
  ],
  "paths": {
    "/api/coinos/skills": {
      "get": {
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HumanSuccessEnvelope"
                }
              }
            }
          }
        },
        "summary": "List available CoinOS skills",
        "tags": [
          "CoinOS"
        ],
        "description": "Returns metadata about all registered CoinOS skills and their availability.",
        "operationId": "getApiCoinosSkills",
        "x-visibility": "internal"
      }
    },
    "/api/coinos/market/{action}": {
      "get": {
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HumanSuccessEnvelope"
                }
              }
            }
          }
        },
        "summary": "AiCoin market data proxy",
        "tags": [
          "CoinOS-Market"
        ],
        "description": "Proxy to all 183 AiCoin Open API v3 endpoints. GET passes query params; POST sends JSON body. Common endpoints: `market/ticker`, `coins/tickers`, `market/klines`, `derivatives/funding-rates`, `content/newsflashes`, `signals/alerts`, etc.",
        "operationId": "getApiCoinosMarketAction",
        "x-visibility": "public"
      },
      "post": {
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HumanSuccessEnvelope"
                }
              }
            }
          }
        },
        "summary": "AiCoin market data proxy",
        "tags": [
          "CoinOS-Market"
        ],
        "description": "Proxy to all 183 AiCoin Open API v3 endpoints. GET passes query params; POST sends JSON body. Common endpoints: `market/ticker`, `coins/tickers`, `market/klines`, `derivatives/funding-rates`, `content/newsflashes`, `signals/alerts`, etc.",
        "operationId": "postApiCoinosMarketAction",
        "x-visibility": "public"
      },
      "parameters": [
        {
          "in": "path",
          "name": "action",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    "/api/coinos/market-catalog": {
      "get": {
        "responses": {
