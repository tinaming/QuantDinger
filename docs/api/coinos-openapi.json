                }
              }
            }
          }
        },
        "summary": "Exchange registration referral",
        "tags": [
          "CoinOS-Account"
        ],
        "description": "Get AiCoin referral link for exchange registration with kickback.",
        "operationId": "postApiCoinosAccountRegisterExchange",
        "x-visibility": "internal"
      },
      "parameters": [
        {
          "in": "path",
          "name": "exchange",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "/api/coinos/onchain/{script}/{action}": {
      "post": {
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HumanSuccessEnvelope"
                }
              }
            }
          }
        },
        "summary": "On-chain DEX operations",
        "tags": [
          "CoinOS-Onchain"
        ],
        "description": "OKX Web3 DEX API: token swap, wallet portfolio, gas estimation, transaction broadcasting. Scripts: `swap`, `portfolio`, `market`, `token`, `trade`, `gateway`.",
        "operationId": "postApiCoinosOnchainScriptAction",
        "x-visibility": "internal"
      },
      "parameters": [
        {
          "in": "path",
          "name": "script",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1
          }
        },
        {
          "in": "path",
          "name": "action",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    }
  },
  "components": {
    "schemas": {
      "HumanSuccessEnvelope": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "description": "1 on success",
            "example": 1
          },
          "msg": {
            "type": "string",
            "example": "success"
          },
          "data": {
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "HumanJWT": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "User session JWT from `POST /api/auth/login`. Send as `Authorization: Bearer <token>`."
      },
      "AgentToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "qd_agent_xxx",
        "description": "Agent Gateway token for `/api/agent/v1/*` only. See docs/agent/AGENT_QUICKSTART.md."
      }
    }
  }
}
