                  "$ref": "#/components/schemas/HumanSuccessEnvelope"
                }
              }
            }
          }
        },
        "summary": "Exchange registration (referral)",
        "tags": [
          "CoinOS-Trading"
        ],
        "description": "Get AiCoin referral link for exchange registration.",
        "operationId": "postApiCoinosTradingRegisterExchange",
        "x-visibility": "internal"
      },
      "parameters": [
        {
          "in": "path",
          "name": "exchange",
          "required": true,
