              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HumanSuccessEnvelope"
                }
              }
            }
          }
        },
        "summary": "AiCoin API catalog",
        "tags": [
          "CoinOS-Market"
        ],
        "description": "List all available AiCoin v3 API endpoints with parameters.",
        "operationId": "getApiCoinosMarketCatalog",
        "x-visibility": "public"
      }
    },
    "/api/coinos/market-key-info": {
      "get": {
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HumanSuccessEnvelope"
                }
              }
            }
          }
        },
        "summary": "AiCoin API key info",
        "tags": [
          "CoinOS-Market"
        ],
        "description": "Check current AiCoin API key tier and permissions.",
        "operationId": "getApiCoinosMarketKeyInfo",
        "x-visibility": "public"
      }
