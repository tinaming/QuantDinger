                }
              }
            }
          }
        },
        "summary": "Freqtrade strategy deployment",
        "tags": [
          "CoinOS-Freqtrade"
        ],
        "description": "Create, backtest, hyperopt, and deploy Freqtrade strategies. Actions: `check`, `deploy`, `create_strategy`, `backtest`, `hyperopt`, `download_data`, `strategy_list`, `start`, `stop`, `status`, `logs`.",
        "operationId": "postApiCoinosFreqtradeDeployAction",
        "x-visibility": "internal"
      },
      "parameters": [
        {
          "in": "path",
          "name": "action",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "/api/coinos/freqtrade/control/{action}": {
      "post": {
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HumanSuccessEnvelope"
                }
              }
            }
          }
        },
        "summary": "Freqtrade live bot control",
        "tags": [
          "CoinOS-Freqtrade"
        ],
        "description": "Control a running Freqtrade bot: query profit, trades, balance, switch strategy/pairs, force enter/exit, reload config. Actions: `daemon_info`, `profit`, `trades_open`, `trades_history`, `balance`, `profit_per_pair`, `daily`, `weekly`, `monthly`, `force_enter`, `force_exit`, `set_strategy`, `set_pairs`, `set_dry_run`, `restart`, `reload`, `start`, `stop`, `logs`.",
        "operationId": "postApiCoinosFreqtradeControlAction",
        "x-visibility": "internal"
      },
      "parameters": [
        {
          "in": "path",
          "name": "action",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "/api/coinos/freqtrade/dev/{action}": {
      "post": {
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HumanSuccessEnvelope"
                }
              }
            }
          }
        },
        "summary": "Freqtrade development tools",
        "tags": [
          "CoinOS-Freqtrade"
        ],
        "description": "Strategy debugging: candles, whitelist, blacklist, strategy details.",
        "operationId": "postApiCoinosFreqtradeDevAction",
