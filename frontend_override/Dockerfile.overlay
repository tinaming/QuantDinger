# Dockerfile.overlay — Brand replacement overlay for frontend static files
#
# Strategy: extend the upstream GHCR frontend image, overlaying locally
# brand-replaced static files on top of the original nginx html directory.
# This preserves the upstream nginx.conf, entrypoint, and health-check config.
#
# The local html/ directory was created by:
#   1. docker cp quantdinger-frontend:/usr/share/nginx/html/ frontend_override/html/
#   2. powershell -File frontend_override/replace-brand.ps1
#
# Build (from repo root):
#   docker build -t chanquant-frontend:branded \
#     -f frontend_override/Dockerfile.overlay .
FROM ghcr.io/brokermr810/quantdinger-frontend:latest

# Overlay brand-replaced files (overwrites matching paths, adds new logo SVGs)
# Includes /docs/dev-guide[-cn].html for Indicator IDE 「开发教程」 (no external GitHub).
COPY frontend_override/html /usr/share/nginx/html

# COPY cannot delete upstream hashed chunks. Remove superseded immutable names so
# browsers cannot keep forever-cached importers that never discover -cq1.
RUN rm -f \
      /usr/share/nginx/html/assets/index-DvAGmmZH.js \
      /usr/share/nginx/html/assets/index-Bv_zhOcS.js \
      /usr/share/nginx/html/assets/index-CpKYkjon.js
